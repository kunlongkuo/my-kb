{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "ask",
    "run_command": "ask",
    "skill": {
      "video-production-workflow": "allow",
      "video-autopilot": "allow",
      "video-use-editor": "allow",
      "motion-explainer": "allow",
      "motion-explainer-images": "allow",
      "motion-explainer-video": "allow",
      "motion-design": "allow",
      "review-loop": "allow"
    }
  },
  "mcp": {
    "notebooklm": {
      "type": "local",
      "command": ["nlm", "mcp"],
      "enabled": true
    },
    "firebase": {
      "type": "local",
      "command": ["npx.cmd", "-y", "firebase-tools@latest", "mcp"],
      "enabled": true
    }
  },
  "generate_image": {
    "default_language": "zh-TW",
    "api_key_required": false
  }
}
